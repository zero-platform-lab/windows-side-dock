<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Id="ZeroPlatformLab.WindowsSideDock"
    Name="Windows Side Dock"
    Manufacturer="zero-platform-lab"
    Version="$(Version)"
    Scope="perUser"
    Codepage="65001">

    <MajorUpgrade
      AllowSameVersionUpgrades="yes"
      DowngradeErrorMessage="新しいバージョンの Windows Side Dock が既にインストールされています。" />

    <!-- 「アプリと機能」に出すアイコン。 -->
    <Icon Id="AppIcon" SourceFile="$(sys.SOURCEFILEDIR)..\assets\icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!--
      右クリックメニューのスパースパッケージを登録・解除する。PowerShellの窓を出さないよう WixQuietExec で動かす。
      署名を信頼していないPCでは登録に失敗するが、従来の右クリックメニューは使えるのでインストールは続ける。
    -->
    <SetProperty
      Id="RegisterShellMenu"
      Sequence="execute"
      Before="RegisterShellMenu"
      Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;Add-AppxPackage -Path '[INSTALLFOLDER]windows-side-dock-shell.msix' -ExternalLocation '[INSTALLFOLDER]'&quot;" />
    <CustomAction
      Id="RegisterShellMenu"
      BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
      DllEntry="WixQuietExec"
      Execute="deferred"
      Impersonate="yes"
      Return="ignore" />
    <SetProperty
      Id="UnregisterShellMenu"
      Sequence="execute"
      Before="UnregisterShellMenu"
      Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;Get-AppxPackage -Name ZeroPlatformLab.WindowsSideDock.ShellMenu | Remove-AppxPackage&quot;" />
    <CustomAction
      Id="UnregisterShellMenu"
      BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
      DllEntry="WixQuietExec"
      Execute="deferred"
      Impersonate="yes"
      Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="UnregisterShellMenu" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot;" />
      <Custom Action="RegisterShellMenu" After="InstallFiles" Condition="NOT REMOVE" />
    </InstallExecuteSequence>

    <StandardDirectory Id="PerUserProgramFilesFolder">
      <Directory Id="INSTALLFOLDER" Name="Windows Side Dock">
        <Component Id="ApplicationFiles" Guid="5B32799D-28DD-4E7F-9FE3-92390EB63443">
          <File Id="WindowsSideDockExe" Source="$(SourceDir)\windows-side-dock.exe" KeyPath="yes">
            <Shortcut
              Id="StartMenuShortcut"
              Directory="ProgramMenuFolder"
              Name="Windows Side Dock"
              WorkingDirectory="INSTALLFOLDER"
              Advertise="no" />
          </File>
        </Component>
        <!-- Windows 11 の右クリックメニュー。DLLはここに置き、MSIXがエクスプローラーに登録する。 -->
        <Component Id="ShellMenuFiles" Guid="8E0B5C44-3B1F-4E0B-9F2C-6A7D1C2E9B31">
          <File Id="ShellMenuDll" Source="$(SourceDir)\windows_side_dock_shell.dll" KeyPath="yes" />
          <File Id="ShellMenuPackage" Source="$(SourceDir)\windows-side-dock-shell.msix" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Component Id="DesktopBackgroundMenu" Directory="INSTALLFOLDER" Guid="35400EB0-983E-46AD-8E4E-2E7ED029CB8F">
      <RegistryValue
        Root="HKCU"
        Key="Software\Classes\DesktopBackground\Shell\WindowsSideDock"
        Name="MUIVerb"
        Type="string"
        Value="Windows Side Dock"
        KeyPath="yes" />
      <RegistryValue Root="HKCU" Key="Software\Classes\DesktopBackground\Shell\WindowsSideDock" Name="Icon" Type="string" Value="[INSTALLFOLDER]windows-side-dock.exe" />
      <RegistryValue Root="HKCU" Key="Software\Classes\DesktopBackground\Shell\WindowsSideDock" Name="SubCommands" Type="string" Value="" />
      <RegistryValue Root="HKCU" Key="Software\Classes\DesktopBackground\Shell\WindowsSideDock\shell\01Folder" Name="MUIVerb" Type="string" Value="Windows Side Dockの場所を開く" />
      <RegistryValue Root="HKCU" Key="Software\Classes\DesktopBackground\Shell\WindowsSideDock\shell\01Folder\command" Type="string" Value="explorer.exe &quot;[INSTALLFOLDER]&quot;" />
      <RegistryValue Root="HKCU" Key="Software\Classes\DesktopBackground\Shell\WindowsSideDock\shell\02ProcessTool" Name="MUIVerb" Type="string" Value="タスク マネージャー" />
      <RegistryValue Root="HKCU" Key="Software\Classes\DesktopBackground\Shell\WindowsSideDock\shell\02ProcessTool\command" Type="string" Value="taskmgr.exe" />
    </Component>

    <Component Id="DirectoryBackgroundMenu" Directory="INSTALLFOLDER" Guid="B5E3A55F-C74C-42FF-B654-44CE70E04B93">
      <RegistryValue
        Root="HKCU"
        Key="Software\Classes\Directory\Background\Shell\WindowsSideDock"
        Name="MUIVerb"
        Type="string"
        Value="Windows Side Dock"
        KeyPath="yes" />
      <RegistryValue Root="HKCU" Key="Software\Classes\Directory\Background\Shell\WindowsSideDock" Name="Icon" Type="string" Value="[INSTALLFOLDER]windows-side-dock.exe" />
      <RegistryValue Root="HKCU" Key="Software\Classes\Directory\Background\Shell\WindowsSideDock" Name="SubCommands" Type="string" Value="" />
      <RegistryValue Root="HKCU" Key="Software\Classes\Directory\Background\Shell\WindowsSideDock\shell\01Folder" Name="MUIVerb" Type="string" Value="Windows Side Dockの場所を開く" />
      <RegistryValue Root="HKCU" Key="Software\Classes\Directory\Background\Shell\WindowsSideDock\shell\01Folder\command" Type="string" Value="explorer.exe &quot;[INSTALLFOLDER]&quot;" />
      <RegistryValue Root="HKCU" Key="Software\Classes\Directory\Background\Shell\WindowsSideDock\shell\02ProcessTool" Name="MUIVerb" Type="string" Value="タスク マネージャー" />
      <RegistryValue Root="HKCU" Key="Software\Classes\Directory\Background\Shell\WindowsSideDock\shell\02ProcessTool\command" Type="string" Value="taskmgr.exe" />
    </Component>

    <!-- ログオン時にDockを自動起動する。アンインストールで削除される。 -->
    <Component Id="StartupRegistration" Directory="INSTALLFOLDER" Guid="31646E5E-58EE-416F-8181-7B1D6EFDCBA3">
      <RegistryValue
        Root="HKCU"
        Key="Software\Microsoft\Windows\CurrentVersion\Run"
        Name="WindowsSideDock"
        Type="string"
        Value="&quot;[INSTALLFOLDER]windows-side-dock.exe&quot;"
        KeyPath="yes" />
    </Component>

    <Feature Id="MainFeature" Title="Windows Side Dock" Level="1">
      <ComponentRef Id="ApplicationFiles" />
      <ComponentRef Id="ShellMenuFiles" />
      <ComponentRef Id="DesktopBackgroundMenu" />
      <ComponentRef Id="DirectoryBackgroundMenu" />
      <ComponentRef Id="StartupRegistration" />
    </Feature>

    <CustomAction
      Id="LaunchApplication"
      FileRef="WindowsSideDockExe"
      ExeCommand=""
      Execute="immediate"
      Return="asyncNoWait"
      Impersonate="yes" />
    <InstallExecuteSequence>
      <Custom Action="LaunchApplication" After="InstallFinalize" Condition="NOT REMOVE~=&quot;ALL&quot;" />
    </InstallExecuteSequence>
  </Package>
</Wix>
